# Copy to .env and fill in. Never commit the real .env file.
# Full explanation of every variable: https://docs.amit.is-a.dev/mail-server/setup

# Resend: API key (send + receive) and the signing secret of the email.received webhook
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Comma-separated addresses you receive on. The first is the default "From" address.
ALLOWED_ALIASES=mail@example.com

# The one Google account allowed to sign in to the web app
MAILBOX_OWNER_EMAIL=you@example.com

# Optional display name on sent mail
FROM_NAME=

# Firebase service-account JSON: raw on a single line, or base64-encoded
FIREBASE_SERVICE_ACCOUNT=

# Firebase web-app config as JSON
FIREBASE_WEB_CONFIG={"apiKey":"","authDomain":"","projectId":"","appId":""}

# Web Push keys. Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional contact for the push service (defaults to the first alias)
VAPID_SUBJECT=mailto:mail@example.com

# Optional, defaults to 3000
PORT=3000
